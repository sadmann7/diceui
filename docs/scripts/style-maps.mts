import { watch } from "node:fs";
import { promises as fs } from "node:fs";
import path from "node:path";
import { createStyleMap } from "shadcn/utils";

import { DEFAULT_STYLE } from "../lib/constants";
import { STYLES } from "../registry/styles";
import { writeIconsModule } from "./build-icons.mts";

export type StyleMap = ReturnType<typeof createStyleMap>;

const REGISTRY_PATH = path.join(process.cwd(), "registry");
const STYLES_SRC_PATH = path.join(REGISTRY_PATH, "styles");
const GENERATED_PATH = path.join(STYLES_SRC_PATH, "__generated__");

export async function getStyleMaps() {
  const read = (file: string) =>
    fs.readFile(path.join(STYLES_SRC_PATH, file), "utf8").catch(() => null);
  const defaultCss = await read(`style-${DEFAULT_STYLE}.css`);
  if (!defaultCss) throw new Error(`Missing style-${DEFAULT_STYLE}.css`);

  const mapsByCss = new Map<string, StyleMap>();
  return new Map(
    await Promise.all(
      STYLES.map(async (style) => {
        const css = [
          (await read(`style-${style.name}.css`)) ?? defaultCss,
          await read(`shadcn/style-${style.name}.css`),
        ].join("\n");
        if (!mapsByCss.has(css)) mapsByCss.set(css, createStyleMap(css));
        return [style.name, mapsByCss.get(css)!] as const;
      }),
    ),
  );
}

const HEADER =
  "// This file is autogenerated by scripts/style-maps.mts.\n// Do not edit this file directly.\n\n";

export async function writeStyleMapsModule() {
  const styleMaps = await getStyleMaps();
  const stylesPath = path.join(GENERATED_PATH, "styles");

  await fs.mkdir(stylesPath, { recursive: true });
  await Promise.all([
    // Every style, for the server and for Tailwind to scan.
    fs.writeFile(
      path.join(GENERATED_PATH, "style-maps.ts"),
      `${HEADER}export const STYLE_MAPS: Record<string, Record<string, string>> = ${JSON.stringify(
        Object.fromEntries(styleMaps),
        null,
        2,
      )};\n`,
    ),
    // One module per style, so the docs load only the style in use.
    ...[...styleMaps].map(([style, styleMap]) =>
      fs.writeFile(
        path.join(stylesPath, `${style}.ts`),
        `${HEADER}const styleMap: Record<string, string> = ${JSON.stringify(styleMap, null, 2)};\n\nexport default styleMap;\n`,
      ),
    ),
    fs.writeFile(
      path.join(GENERATED_PATH, "style-map-loaders.ts"),
      `${HEADER}import defaultStyleMap from "./styles/${DEFAULT_STYLE}";\n\nexport { defaultStyleMap };\n\nexport const styleMapLoaders: Record<string, () => Promise<{ default: Record<string, string> }>> = {\n${[
        ...styleMaps.keys(),
      ]
        .map(
          (style) =>
            `  ${JSON.stringify(style)}: () => import("./styles/${style}"),`,
        )
        .join("\n")}\n};\n`,
    ),
  ]);
}

if (import.meta.url === `file://${process.argv[1]}`) {
  await Promise.all([writeStyleMapsModule(), writeIconsModule()]);

  if (process.argv.includes("--watch")) {
    let stylesTimer: ReturnType<typeof setTimeout> | undefined;
    watch(STYLES_SRC_PATH, (_event, filename) => {
      if (!filename?.endsWith(".css")) return;
      clearTimeout(stylesTimer);
      stylesTimer = setTimeout(() => {
        writeStyleMapsModule().catch((error: unknown) => console.error(error));
      }, 50);
    });

    let iconsTimer: ReturnType<typeof setTimeout> | undefined;
    watch(REGISTRY_PATH, { recursive: true }, (_event, filename) => {
      if (!filename?.endsWith(".tsx") || filename.includes("__generated__")) {
        return;
      }
      clearTimeout(iconsTimer);
      iconsTimer = setTimeout(() => {
        writeIconsModule().catch((error: unknown) => console.error(error));
      }, 50);
    });
  }
}
