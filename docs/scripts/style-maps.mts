import { watch } from "node:fs";
import { promises as fs } from "node:fs";
import path from "node:path";
import { createStyleMap } from "shadcn/utils";

import { DEFAULT_STYLE } from "../lib/constants";
import { STYLES } from "../registry/styles";

export type StyleMap = ReturnType<typeof createStyleMap>;

const STYLES_SRC_PATH = path.join(process.cwd(), "registry", "styles");
const GENERATED_PATH = path.join(STYLES_SRC_PATH, "__generated__");

export async function getStyleMaps() {
  const read = (name: string) =>
    fs
      .readFile(path.join(STYLES_SRC_PATH, `style-${name}.css`), "utf8")
      .catch(() => null);
  const defaultCss = await read(DEFAULT_STYLE);
  if (!defaultCss) throw new Error(`Missing style-${DEFAULT_STYLE}.css`);

  const mapsByCss = new Map<string, StyleMap>();
  return new Map(
    await Promise.all(
      STYLES.map(async (style) => {
        const css = (await read(style.name)) ?? defaultCss;
        if (!mapsByCss.has(css)) mapsByCss.set(css, createStyleMap(css));
        return [style.name, mapsByCss.get(css)!] as const;
      }),
    ),
  );
}

export function getMarkerClasses(styleMaps: Map<string, StyleMap>) {
  const defaultMap = styleMaps.get(DEFAULT_STYLE)!;

  return Object.fromEntries(
    Object.entries(defaultMap).map(([marker, classes]) => {
      const defaultClasses = new Set(classes.split(/\s+/));
      const overrides = [...styleMaps]
        .filter(([style]) => style !== DEFAULT_STYLE)
        .flatMap(([style, styleMap]) =>
          (styleMap[marker] ?? "")
            .split(/\s+/)
            .filter((token) => token && !defaultClasses.has(token))
            .map((token) => `style-${style}:${token}`),
        );

      return [marker, [classes, ...overrides].join(" ")];
    }),
  );
}

export async function writeStyleMapsModule() {
  const styleMaps = await getStyleMaps();

  await fs.mkdir(GENERATED_PATH, { recursive: true });
  await fs.writeFile(
    path.join(GENERATED_PATH, "style-maps.ts"),
    `// This file is autogenerated by scripts/style-maps.mts.\n// Do not edit this file directly.\n\nexport const STYLE_MAPS: Record<string, Record<string, string>> = ${JSON.stringify(
      Object.fromEntries(styleMaps),
      null,
      2,
    )};\n\nexport const MARKER_CLASSES: Record<string, string> = ${JSON.stringify(
      getMarkerClasses(styleMaps),
      null,
      2,
    )};\n`,
  );
}

if (import.meta.url === `file://${process.argv[1]}`) {
  await writeStyleMapsModule();

  if (process.argv.includes("--watch")) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    watch(STYLES_SRC_PATH, (_event, filename) => {
      if (!filename?.endsWith(".css")) return;
      clearTimeout(timer);
      timer = setTimeout(() => {
        writeStyleMapsModule().catch((error: unknown) => console.error(error));
      }, 50);
    });
  }
}
