import { promises as fs } from "node:fs";
import path from "node:path";

import { writeFileIfChanged } from "./write-files.mts";

// `IconPlaceholder` looks icons up by name, so it re-exports only the lucide
// icons the registry names instead of importing all of `lucide-react`.

const REGISTRY_PATH = path.join(process.cwd(), "registry");
const OUTPUT_PATH = path.join(REGISTRY_PATH, "icons", "__generated__");

async function getSourceFiles(dir: string): Promise<string[]> {
  const entries = await fs.readdir(dir, { withFileTypes: true });
  const files = await Promise.all(
    entries.map(async (entry) => {
      const file = path.join(dir, entry.name);
      if (entry.isDirectory()) {
        return entry.name === "__generated__" ? [] : getSourceFiles(file);
      }
      return entry.name.endsWith(".tsx") ? [file] : [];
    }),
  );
  return files.flat();
}

export async function writeIconsModule() {
  const sources = await Promise.all(
    (await getSourceFiles(REGISTRY_PATH)).map((file) =>
      fs.readFile(file, "utf8"),
    ),
  );
  const names = [
    ...new Set(
      sources.flatMap((source) =>
        [...source.matchAll(/\blucide="([A-Za-z0-9]+)"/g)].map((m) => m[1]!),
      ),
    ),
  ].sort();

  const content = `// This file is autogenerated by scripts/build-icons.mts.\n// Do not edit this file directly.\n\nexport {\n${names.map((name) => `  ${name},`).join("\n")}\n} from "lucide-react";\n`;
  await writeFileIfChanged(path.join(OUTPUT_PATH, "lucide.ts"), content);
}

if (import.meta.url === `file://${process.argv[1]}`) {
  await writeIconsModule();
}
