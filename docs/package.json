{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:registry && next build",
    "generate:content": "fumadocs-mdx",
    "build:registry": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts",
    "build:styles": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts --styles",
    "validate:registry": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/validate-registry.mts",
    "clean:registry": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/clean-registry.mts",
    "test:registry": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/test-registry.mts",
    "dev": "pnpm styles:dev & next dev --turbopack",
    "styles:dev": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/style-maps.mts --watch",
    "shadcn:sync": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/sync-shadcn.mts",
    "styles:sync": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/sync-styles.mts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config ../vitest.config.ts",
    "shadcn": "pnpm dlx shadcn@latest"
  },
  "dependencies": {
