### STANDARD GIT IGNORE FILE ###

# DEPENDENCIES
node_modules/
/.pnp
.pnp.js
package-lock.json
yarn.lock

# GENERATED CONTENT
.map.ts
.contentlayer

# TESTING
/coverage
*.lcov
.nyc_output

# BUILD
build/
public/build/
dist/
generated/

# ENV FILES
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# LOGS
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# MISC
.idea
.cache/
.next/
next-env.d.ts
.nuxt/
tmp/
temp/
.docusaurus

# TYPESCRIPT
*.tsbuildinfo

# MAC
._*
.DS_Store
Thumbs.db

.turbo
.vercel
.source

# generated registry output (rebuilt by `pnpm build:registry` on every deploy).
# styles/index.json is the published style-id list; everything else under
# public/r is produced from the authored base trees.
/docs/public/r/styles/*
!/docs/public/r/styles/index.json
/docs/public/r/*.json

# Emacs backup files
\#*
.\#*
