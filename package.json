{
  "name": "diceui",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob **/node_modules **/dist **/.source **/.turbo **/.next **/pnpm-lock.yaml **/.tsbuildinfo",
    "clean:cache": "rimraf --glob **/.turbo **/.next/cache **/node_modules/.cache **/node_modules/.vite",
    "build": "turbo run build",
    "build:registry": "pnpm --filter=docs build:registry --loglevel silent",
    "validate:registry": "pnpm --filter=docs validate:registry --loglevel silent",
    "cleanup:registry": "pnpm --filter=docs cleanup:registry --loglevel silent",
    "test:registry": "pnpm --filter=docs test:registry --loglevel silent",
    "build:packages": "pnpm --filter \"@diceui/*\" build",
    "dev": "turbo run dev",
    "docs:dev": "turbo run dev --filter=docs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "check": "oxlint . && oxfmt --check . && turbo run typecheck",
    "test": "turbo run test",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "expect-type": "^1.4.0",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}
