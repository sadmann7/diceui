{
  "name": "@diceui/mention",
  "version": "0.8.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mention",
    "mention input",
    "react-mention",
    "mention-autocomplete"
  ],
  "author": "Sadman Sakib",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sadmann7/diceui",
    "directory": "packages/mention"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^16.8 || ^17.0 || ^18.0 || ^19.0 || ^19.0.0-rc",
    "react-dom": "^16.8 || ^17.0 || ^18.0 || ^19.0 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@diceui/shared": "workspace:*",
    "@floating-ui/react": "catalog:"
  }
}
