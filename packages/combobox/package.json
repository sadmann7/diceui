    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@diceui/shared": "workspace:*",
    "@floating-ui/react": "catalog:"
