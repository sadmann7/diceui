{
  "name": "@diceui/combobox",
  "version": "2.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "combobox",
    "autocomplete",
    "react-combobox",
    "multi-select"
  ],
  "author": "Sadman Sakib",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sadmann7/diceui",
    "directory": "packages/combobox"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
